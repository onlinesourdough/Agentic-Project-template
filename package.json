{
  "name": "@arcitai/solution-template",
  "version": "0.4.0",
  "description": "A standalone AI-native technical foundation for applications, services, automations, integrations, and systems.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gustavonline/solution-template.git"
  },
  "homepage": "https://github.com/gustavonline/solution-template#readme",
  "bugs": {
    "url": "https://github.com/gustavonline/solution-template/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "format:check": "prettier --check \"**/*.{md,json,yml,yaml,mjs}\"",
    "lint:markdown": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "lint:links": "node scripts/check-links.mjs",
    "lint:skills": "node scripts/check-skills.mjs",
    "lint:yaml": "node scripts/check-yaml.mjs",
    "check": "npm run format:check && npm run lint:markdown && npm run lint:yaml && npm run lint:skills && npm run test && npm run lint:links"
  },
  "devDependencies": {
    "markdown-link-check": "3.14.2",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.6",
    "yaml": "2.9.0"
  }
}
