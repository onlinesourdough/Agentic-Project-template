{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/apt/optional-orchestration/request-v1.schema.json",
  "title": "Optional orchestration delivery request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "deliveryId", "operation", "items"],
  "properties": {
    "schemaVersion": { "const": "v1" },
    "deliveryId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "operation": { "const": "normalize" },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["itemId", "text", "behavior"],
        "properties": {
          "itemId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
          "text": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "\\S" },
          "behavior": { "enum": ["ok", "reject"] }
        }
      }
    }
  }
}
