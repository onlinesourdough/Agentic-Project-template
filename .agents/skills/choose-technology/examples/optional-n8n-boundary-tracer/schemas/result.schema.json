{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/apt/optional-orchestration/result-v1.schema.json",
  "title": "Optional orchestration delivery result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "deliveryId", "status", "deduplicated", "outputs", "failures"],
  "properties": {
    "schemaVersion": { "const": "v1" },
    "deliveryId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "status": { "enum": ["completed", "partial"] },
    "deduplicated": { "type": "boolean" },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["itemId", "normalizedText"],
        "properties": {
          "itemId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
          "normalizedText": { "type": "string", "minLength": 1, "maxLength": 80 }
        }
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["itemId", "code"],
        "properties": {
          "itemId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
          "code": { "const": "ITEM_REJECTED" }
        }
      }
    }
  }
}
